# Japanese Academy on Apache: this folder (the upload's public/) is the
# document root. It holds the built Angular app and index.php, the front
# controller of the PHP backend beside it. See docs/kb/hosting.md.

# The sign-in token. PHP under CGI or FastCGI does not see the Authorization
# header unless Apache passes it on: CGIPassAuth does (Apache 2.4.13 or
# newer), and SetEnvIf is the fallback for older servers.
<IfModule mod_version.c>
    <IfVersion >= 2.4.13>
        CGIPassAuth On
    </IfVersion>
</IfModule>
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # The backend's addresses: the API, the audio clips, the reports and the
    # setup page. None of them is a file here.
    RewriteRule ^(api|audio|report)(/|$) index.php [L]
    RewriteRule ^setup\.php$ index.php [L]
    # A file of the app, as it is.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    # A page of the app (/kanji/reviews): its index.html, whose router draws
    # it. An address with a file extension that is not a file is a 404.
    RewriteCond %{REQUEST_URI} !\.[^/]*$
    RewriteRule ^ index.html [L]
</IfModule>

# The browser takes every file for the type the server names, and never guesses.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    # The app itself is asked for again each time; the files the build names
    # with a hash of their content never change under that name.
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
        Header set X-Frame-Options "DENY"
        Header set Referrer-Policy "no-referrer"
    </FilesMatch>
    <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
