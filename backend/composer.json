{
  "name": "anotoki/japanese-academy",
  "description": "Japanese Academy's backend: the kanji SRS and the exam, on Slim 4 and PostgreSQL.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "anotoki/lib": "^0.8.0",
    "slim/psr7": "^1.8",
    "slim/slim": "^4.15"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "extra": {
    "anotoki-deploy": {
      "site": "japanese-academy",
      "remote": "/anotoki.eu/sub/japanese",
      "url": "https://japanese.anotoki.eu",
      "include": [
        "api",
        "src",
        "migrations",
        "vendor",
        "config/config.php",
        "setup.php",
        "composer.json",
        "composer.lock",
        "data/vocab.json",
        "data/kanji.json",
        "data/audio.json",
        "data/authored-items-part1.php",
        "data/authored-items-part2.php"
      ],
      "routes": ["api", "audio", "report"],
      "entry": "api/release.php",
      "before": ["node backend/tools/php.js backend/tools/check-drafts.php"],
      "frontendBuild": "node scripts/ensure-build.mjs",
      "headers": { "Referrer-Policy": "no-referrer" },
      "smoke": ["/api/health"],
      "content": { "audio": { "from": "backend/data/audio", "to": "content/audio" } }
    }
  },
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "php -S localhost:8200 router.php"
    ]
  },
  "scripts-descriptions": {
    "start": "Japanese Academy on http://localhost:8200: the API, the setup page and the last build of the app (router.php); nothing happens at start, and a new migration waits for an ADMIN's Apply on the Migrations page"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/irelevant25/anotoki-lib"
    }
  ]
}
