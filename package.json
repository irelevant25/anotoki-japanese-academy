{
  "name": "japanese-academy",
  "version": "3.0.0",
  "private": true,
  "description": "Japanese Academy — WaniKani-style kanji SRS and a full course exam, with spoken vocabulary in two voices. Backend: PHP (Slim 4) + PostgreSQL in backend/; frontend: Angular in frontend/. These scripts run both.",
  "type": "commonjs",
  "scripts": {
    "start": "node backend/tools/php.js backend/server.php",
    "frontend": "npm --prefix frontend start",
    "manage": "node backend/tools/php.js backend/manage.php",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node backend/tools/php.js backend/tests/run.php",
    "test:frontend": "npm --prefix frontend test",
    "test:browser": "node frontend/scripts/ensure-build.mjs && node frontend/e2e/run.js",
    "test:setup": "node frontend/scripts/ensure-build.mjs && node frontend/e2e/setup.js",
    "screens": "node frontend/scripts/ensure-build.mjs && node frontend/e2e/screens.js",
    "build:frontend": "node frontend/scripts/ensure-build.mjs",
    "build:data": "node backend/tools/php.js backend/tools/build-data.php",
    "build:audio": "node backend/tools/php.js backend/tools/build-audio.php",
    "build:dist": "node backend/tools/php.js backend/tools/build-dist.php",
    "pdf:pages": "node backend/tools/pdf/pages.js"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
